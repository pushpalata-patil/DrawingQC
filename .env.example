# Copy to .env (or paste these into Portainer's stack "Environment variables").
# Only POSTGRES_PASSWORD is required; the rest have sensible defaults.

# Database credentials (the web app connects to the db service with these).
POSTGRES_USER=sa_app
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=supportautomation

# Host port the site is published on (container always listens on 8080).
# e.g. open http://<vm-ip>:8080  — put a reverse proxy in front for 80/443 + HTTPS.
WEB_PORT=8080
