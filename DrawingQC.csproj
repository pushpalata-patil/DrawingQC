<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <!-- These are separate projects nested in subfolders. Exclude them so this
       console app only compiles its own Program.cs and not their sources or
       generated files. -->
  <ItemGroup>
    <Compile Remove="DrawingQC.UI\**\*.cs" />
    <Compile Remove="DrawingQC.Web\**\*.cs" />
    <Compile Remove="src\**\*.cs" />
  </ItemGroup>

</Project>
