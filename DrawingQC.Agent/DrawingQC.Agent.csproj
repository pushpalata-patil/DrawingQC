<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    DrawingQC Local Agent: runs on the engineer's Windows PC, next to AutoCAD / Plant 3D and
    Microsoft Word. The hosted web app (Render) calls it on http://127.0.0.1:5081 to sync the QC
    register into the open drawing and to generate booklets with the user's own Word.
    Published as a self-contained single .exe by the web Dockerfile (see /agent on the site).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DrawingQC.Agent</RootNamespace>
    <AssemblyName>DrawingQC.Agent</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <!-- Single-file publish settings (the Dockerfile passes the RID / self-contained flags). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the exact same booklet + AutoCAD code the web app runs locally on Windows. -->
    <Compile Include="..\DrawingQC.Web\Booklet.cs" Link="Booklet.cs" />
    <Compile Include="..\DrawingQC.Web\AutoCadSync.cs" Link="AutoCadSync.cs" />
    <Compile Include="..\DrawingQC.Web\AgentInfo.cs" Link="AgentInfo.cs" />
  </ItemGroup>

</Project>
